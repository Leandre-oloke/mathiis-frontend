# Copie ce fichier en ".env.local" (même dossier).

# URL de l'API backend vue depuis le navigateur. En local (backend lancé
# via docker-compose.override.yml, cf. README), il est exposé directement
# sur le port 8000 — pas besoin de passer par nginx.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Connexion Google (Sign in with Google) — optionnel, laisse vide si tu ne
# testes pas cette fonctionnalité. Doit correspondre à GOOGLE_CLIENT_ID
# côté backend (racine du repo, .env).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
